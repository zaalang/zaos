//
// vm iovec
//

import std.stdlib;
import std.fmt;
import vm.page;
import platform;
import cpu;

pub struct iovec
{
  pub usize length;
  pub std::vector<vm::physrange, N:8> host;

  pub iovec()
  {
  }

  pub iovec(iovec &&other)
    where __is_rvalue<typeof(other)>
  {
    std::swap(&mut this.length, &mut other.length);
    std::swap(&mut this.host, &mut other.host);
  }

  pub fn =(iovec mut &this, iovec &&other) -> iovec mut &
    where __is_rvalue<typeof(other)>
  {
    std::swap(&mut this.length, &mut other.length);
    std::swap(&mut this.host, &mut other.host);

    return &this;
  }

  pub fn append(this mut &, vm::physrange range) -> void
  {
    this.length += range.size;
    this.host.push_back(range);
  }

  pub ~iovec()
  {
    vm::unlock(host);
  }
}

pub fn fmt(std::OutputStream mut &os, std::fmt_context mut &ctx, iovec &iovec) throws(std::error) -> void
{
  ctx.written += std::format_to(&mut os, "iovec {{ length: {} }}", iovec.length);
}

pub fn foreach_region_in(iovec &this, usize offset, usize length, var &&callback) -> void
{
  var i = this.host.begin;

  for (; i != this.host.end && (*i).size <= offset; ++i)
    offset -= (*i).size;

  if (offset != 0 && length != 0)
  {
    var addr = (*i).addr + offset;
    var bytes = std::min((*i).size - offset, length);

    callback(vm::physrange(addr, bytes));

    length -= bytes;
    offset = 0;
    i += 1;
  }

  for (; i != this.host.end && length != 0; ++i)
  {
    var addr = (*i).addr;
    var bytes = std::min((*i).size, length);

    callback(vm::physrange(addr, bytes));

    length -= bytes;
  }
}

pub fn memcpy(iovec &dst, usize offset, void *src, usize length) -> vm::result
{
  var i = dst.host.begin;

  if (dst.length < offset + length)
    return overflow;

  for (; i != dst.host.end && (*i).size <= offset; ++i)
    offset -= (*i).size;

  if (offset != 0 && length != 0)
  {
    var addr = (*i).addr + offset;
    var bytes = std::min((*i).size - offset, length);

    std::memcpy(addr.ptr, src, bytes);

    src = cast<void*>(cast<uintptr>(src) + bytes);

    length -= bytes;
    offset = 0;
    i += 1;
  }

  for (; i != dst.host.end && length != 0; ++i)
  {
    var addr = (*i).addr;
    var bytes = std::min((*i).size, length);

    std::memcpy(addr.ptr, src, bytes);

    src = cast<void*>(cast<uintptr>(src) + bytes);

    length -= bytes;
  }

  return ok;
}

pub fn memcpy(void mut *dst, iovec &src, usize offset, usize length) -> vm::result
{
  var i = src.host.begin;

  if (src.length < offset + length)
    return overflow;

  for (; i != src.host.end && (*i).size <= offset; ++i)
    offset -= (*i).size;

  if (offset != 0 && length != 0)
  {
    var addr = (*i).addr + offset;
    var bytes = std::min((*i).size - offset, length);

    std::memcpy(dst, addr.ptr, bytes);

    dst = cast<void mut *>(cast<uintptr>(dst) + bytes);

    length -= bytes;
    offset = 0;
    i += 1;
  }

  for (; i != src.host.end && length != 0; ++i)
  {
    var addr = (*i).addr;
    var bytes = std::min((*i).size, length);

    std::memcpy(dst, addr.ptr, bytes);

    dst = cast<void mut *>(cast<uintptr>(dst) + bytes);

    length -= bytes;
  }

  return ok;
}

pub fn memcpy(iovec &dst, usize offset, iovec &src, usize srcoffset, usize length) -> vm::result
{
  var i = dst.host.begin;

  if (dst.length < offset + length)
    return overflow;

  for (; i != dst.host.end && (*i).size <= offset; ++i)
    offset -= (*i).size;

  if (offset != 0 && length != 0)
  {
    var addr = (*i).addr + offset;
    var bytes = std::min((*i).size - offset, length);

    if (var result = vm::memcpy(addr.ptr, src, srcoffset, bytes); !result)
      return result;

    srcoffset += bytes;
    length -= bytes;
    offset = 0;
    i += 1;
  }

  for (; i != dst.host.end && length != 0; ++i)
  {
    var addr = (*i).addr;
    var bytes = std::min((*i).size, length);

    if (var result = vm::memcpy(addr.ptr, src, srcoffset, bytes); !result)
      return result;

    srcoffset += bytes;
    length -= bytes;
  }

  return ok;
}
