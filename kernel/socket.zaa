//
// socket
//

import std.stdio;
import net.socket;
import net.result;
import vm;
import io;
import vfs;
import mutex as _ : mutex;
import process as _ : process;
import support.rc : Rc;

pub const AF_INET4 = 2;
pub const AF_INET6 = 10;

pub const SOCK_STREAM = 1;
pub const SOCK_DGRAM = 2;
pub const SOCK_RAW = 3;

pub const IPPROTO_IP = 0;
pub const IPPROTO_ICMP = 1;
pub const IPPROTO_TCP = 6;
pub const IPPROTO_UDP = 17;
pub const IPPROTO_IPV6 = 41;
pub const IPPROTO_ICMPV6 = 58;

pub const SHUT_RD = 1;
pub const SHUT_WR = 2;
pub const SHUT_RDWR = 3;

pub struct sockaddr
{
  pub u16 sa_family;
}

pub struct sockaddr_storage
{
  pub u16 ss_family;
  u8[6] __ss_pad1;
  u64 __ss_pad2;
  u8[112] __ss_pad3;

  pub sockaddr_storage(sockaddr *addr, usize alen)
  {
    std::memcpy(&this, addr, alen);
  }

  pub sockaddr_storage() = default;
  pub ~sockaddr_storage() = default;
}

pub struct ctrlhdr
{
  pub u32 ctrl_len;
  pub u32 ctrl_flags;
}

pub struct ctrlattr
{
  pub u16 cta_len;
  pub u16 cta_type;
  pub i32 cta_level;
  pub u8[0] cta_value;
}

pub struct socket
{
  pub i32 family;
  pub i32 type;
  pub i32 protocol;

  pub sockaddr_storage sockname;
  pub sockaddr_storage peername;

  pub io::response readable;
  pub io::response writeable;
  pub io::response queryable;

  pub void mut *state;

  vfs::node node_;

  fn create() -> Rc<socket>
  {
    return std::allocator::new<socket>();
  }

  pub fn node(this mut &) -> Rc<vfs::node>
  {
    return &this.node_;
  }

  pub fn ref(this mut &) -> void
  {
    this.node_.ref();
  }

  pub fn try_ref(this mut &) -> bool
  {
    return this.node_.try_ref();
  }

  pub fn unref(this mut &) -> void
  {
    this.node_.unref();
  }

  pub socket() = default;
  pub ~socket() = default;
}

pub struct ancillary_data
{
  ctrlhdr *ctrl;
  ctrlhdr mut *mutctrl;
  usize ctrllen;

  std::flat_hash_map<(i32, u16), ctrlattr *> attrs;

  pub fn [](this &, (i32, u16) &attr) -> std::optional<ctrlattr *>
  {
    return this.attrs.get(attr);
  }

  pub fn push_back(this mut &, (i32, u16) &attr, void *data, usize len) -> bool
  {
    if (!this.mutctrl)
      return false;

    var ctrl = this.mutctrl;

    if (this.ctrllen < cast<usize>(ctrl.ctrl_len) + sizeof<ctrlattr> + len)
      return false;

    var cta = cast<ctrlattr mut *>(cast<uintptr>(ctrl) + cast<usize>(ctrl.ctrl_len));

    cta.cta_level = attr.0;
    cta.cta_type = attr.1;
    cta.cta_len = cast(sizeof<ctrlattr> + len);

    std::memcpy(cta.cta_value.data, data, len);

    ctrl.ctrl_len += cast(std::align_up(cta.cta_len, 4));

    this.attrs.insert(attr, cta);

    return true;
  }

  pub ancillary_data(ctrlhdr *ctrl, usize ctrllen)
    : ctrl(ctrl), ctrllen(ctrllen)
  {
    std::assert(cast(ctrl.ctrl_len) <= ctrllen);

    for (var offset = sizeof<ctrlhdr>; offset + sizeof<ctrlattr> < cast(ctrl.ctrl_len); )
    {
      var cta = cast<ctrlattr*>(cast<uintptr>(ctrl) + cast<usize>(offset));

      if (cta.cta_len < sizeof<ctrlattr>)
        break;

      if (offset + cast(cta.cta_len) <= cast(ctrl.ctrl_len))
        attrs.insert((cta.cta_level, cta.cta_type), cta);

      offset += cast(std::align_up(cta.cta_len, 4));
    }
  }

  pub ancillary_data(ctrlhdr mut *ctrl, usize ctrllen)
    : this(cast<ctrlhdr*>(ctrl), ctrllen)
  {
    mutctrl = ctrl;
  }

  pub ancillary_data() = default;
  pub ~ancillary_data() = default;
}

pub fn create_socket() -> Rc<socket>
{
  return socket::create();
}

pub fn setup_socket(Rc<socket> mut &socket, i32 family, i32 type, i32 protocol) -> net::result
{
  socket.family = family;
  socket.type = type;
  socket.protocol = protocol;

  io::initiate(&mut socket.readable.cb, 1);
  io::initiate(&mut socket.queryable.cb, 1);

  vfs::node::init(&socket.node_, vfs::node::type::socket, vfs::node::ops::stream(&impl *socket));

  return ok;
}

pub fn open(vfs::node mut *node, vfs::fd mut &fd, process mut *process, u64 flags, u32 mode) -> vfs::result
{
  var socket = cast<socket mut *>(cast<uintptr>(node) - offsetof(socket::node_));

  switch (socket.family)
  {
    case AF_INET6:
      net::open(socket);
  }

  return ok;
}

pub fn getstat(vfs::node mut *node, vfs::stat mut &stat, u64 mask) -> vfs::result
{
  return not_supported;
}

pub fn putstat(vfs::node mut *node, vfs::stat &stat, u64 mask) -> vfs::result
{
  return not_supported;
}

pub fn poll(vfs::node mut *node, Rc<io::iocb> mut &readable, Rc<io::iocb> mut &writeable) -> vfs::result
{
  var mut &socket = *cast<socket mut *>(cast<uintptr>(node) - offsetof(socket::node_));

  readable = socket.readable.cb;
  writeable = socket.writeable.cb;

  return ok;
}

pub fn poll(vfs::node mut *node, Rc<io::iocb> mut &readable, Rc<io::iocb> mut &writeable, Rc<io::iocb> mut &queryable) -> vfs::result
{
  var mut &socket = *cast<socket mut *>(cast<uintptr>(node) - offsetof(socket::node_));

  readable = socket.readable.cb;
  writeable = socket.writeable.cb;
  queryable = socket.queryable.cb;

  return ok;
}

pub fn read(vfs::node mut *node, vm::iovec &iovec, usize offset, usize length, ctrlhdr mut *ctrl, usize ctrllen) -> vfs::result
{
  var socket = cast<socket mut *>(cast<uintptr>(node) - offsetof(socket::node_));

  var ancillary_data = ancillary_data(ctrl, ctrllen);

  switch (socket.family)
  {
    case AF_INET6:
      return net::read(socket, iovec, offset, length, &mut ancillary_data);

    else:
      return not_supported;
  }
}

pub fn read(vfs::node mut *node, vm::iovec &iovec, usize offset, usize length) -> vfs::result
{
  var socket = cast<socket mut *>(cast<uintptr>(node) - offsetof(socket::node_));

  var ancillary_data = ancillary_data();

  switch (socket.family)
  {
    case AF_INET6:
      return net::read(socket, iovec, offset, length, &mut ancillary_data);

    else:
      return not_supported;
  }
}

pub fn write(vfs::node mut *node, vm::iovec &iovec, usize offset, usize length, ctrlhdr *ctrl, usize ctrllen) -> vfs::result
{
  var socket = cast<socket mut *>(cast<uintptr>(node) - offsetof(socket::node_));

  var ancillary_data = ancillary_data(ctrl, ctrllen);

  switch (socket.family)
  {
    case AF_INET6:
      return net::write(socket, iovec, offset, length, ancillary_data);

    else:
      return not_supported;
  }
}

pub fn write(vfs::node mut *node, vm::iovec &iovec, usize offset, usize length) -> vfs::result
{
  var socket = cast<socket mut *>(cast<uintptr>(node) - offsetof(socket::node_));

  var ancillary_data = ancillary_data();

  switch (socket.family)
  {
    case AF_INET6:
      return net::write(socket, iovec, offset, length, ancillary_data);

    else:
      return not_supported;
  }
}

pub fn ioctl(vfs::node mut *node, u32 op, vm::iovec &iovec) -> vfs::result
{
  var socket = cast<socket mut *>(cast<uintptr>(node) - offsetof(socket::node_));

  switch (socket.family)
  {
    case AF_INET6:
      return net::ioctl(socket, op, iovec);

    else:
      return not_supported;
  }
}

pub fn bind(vfs::node mut *node, sockaddr *addr, usize alen) -> net::result
{
  var socket = cast<socket mut *>(cast<uintptr>(node) - offsetof(socket::node_));

  if (alen < sizeof<sockaddr>)
    return invalid_argument;

  switch (socket.family)
  {
    case AF_INET6:
      return net::bind(socket, addr, alen);

    else:
      return not_supported;
  }
}

pub fn connect(vfs::node mut *node, sockaddr *addr, usize alen) -> net::result
{
  var socket = cast<socket mut *>(cast<uintptr>(node) - offsetof(socket::node_));

  if (alen < sizeof<sockaddr>)
    return invalid_argument;

  switch (socket.family)
  {
    case AF_INET6:
      return net::connect(socket, addr, alen);

    else:
      return not_supported;
  }
}

pub fn listen(vfs::node mut *node) -> net::result
{
  return not_supported;
}

pub fn accept(vfs::node mut *node) -> net::result
{
  return not_supported;
}

pub fn shutdown(vfs::node mut *node, u64 how) -> net::result
{
  var socket = cast<socket mut *>(cast<uintptr>(node) - offsetof(socket::node_));

  switch (socket.family)
  {
    case AF_INET6:
      net::shutdown(socket, how);
  }

  return ok;
}

fn destroy(vfs::node mut *node) -> void
{
  var socket = cast<socket mut *>(cast<uintptr>(node) - offsetof(socket::node_));

  switch (socket.family)
  {
    case AF_INET6:
      net::shutdown(socket, SHUT_RDWR);
      net::destroy(socket);
  }

  std::allocator::delete(socket);
}
