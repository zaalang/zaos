//
// semaphore
//

import std.stdio;
import std.atomic;
import cpu;
import scheduler;
import thread as _ : thread;
import waitqueue as _ : wait_queue;

pub struct semaphore
{
  pub u32 value = 0;
  pub u32 maxvalue = 1;

  pub fn wait(this mut &) -> void
  {
    for (;;)
    {
      var current = std::atomic_load(&this.value, std::memory_order::relaxed);

      if (current == 0)
      {
        var guard = std::lock_guard(&mut cpu::irqlock, &mut this.waitlock);

        if (std::atomic_load(&this.value, std::memory_order::acquire) != 0)
          continue;

        this.waiters.wait(&mut this.waitlock);

        current = 1;
      }

      if (std::atomic_cmpxchg_weak(&this.value, current, std::min(current, this.maxvalue) - 1))
        break;
    }
  }

  pub fn try_wait(this mut &) -> bool
  {
    var current = std::atomic_load(&this.value, std::memory_order::relaxed);

    if (current == 0)
      return false;

    return std::atomic_cmpxchg_weak(&this.value, current, std::min(current, this.maxvalue) - 1);
  }

  pub fn try_wait_until(this mut &, u64 abstime) -> bool
  {
    for (;;)
    {
      var current = std::atomic_load(&this.value, std::memory_order::relaxed);

      if (current == 0)
      {
        var guard = std::lock_guard(&mut cpu::irqlock, &mut this.waitlock);

        if (std::atomic_load(&this.value, std::memory_order::acquire) != 0)
          continue;

        if (var rc = this.waiters.wait_until(&mut this.waitlock, abstime); rc < 0)
          return false;

        current = 1;
      }

      if (std::atomic_cmpxchg_weak(&this.value, current, std::min(current, this.maxvalue) - 1))
        break;
    }

    return true;
  }

  pub fn release(this mut &) -> void
  {
    if (std::atomic_add(&this.value, 1, std::memory_order::release) == 0)
    {
      this.waiters.lock_and_wake_one(&mut this.waitlock);
    }
  }

  pub fn reset(this mut &) -> void
  {
    std::atomic_store(&this.value, 0);
  }

  pub semaphore(u32 value, u32 maxvalue)
    : value(value), maxvalue(maxvalue)
  {
  }

  pub semaphore() = default;
  pub semaphore(#semaphore &) = default;
  pub ~semaphore() = default;

  wait_queue waiters;
  std::spin_lock waitlock;
}
