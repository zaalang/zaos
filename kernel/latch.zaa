//
// latch
//

import std.stdio;
import std.atomic;
import cpu;
import scheduler;
import thread as _ : thread;
import waitqueue as _ : wait_queue;

pub struct latch
{
  pub u32 value = 0;

  pub fn wait(this mut &) -> void
  {
    if (std::atomic_load(&this.value, std::memory_order::relaxed) != 0)
    {
      var guard = std::lock_guard(&mut cpu::irqlock, &mut this.spinlock);

      if (std::atomic_load(&this.value, std::memory_order::acquire) == 0)
        return;

      this.waiters.wait(&mut this.spinlock);
    }
  }

  pub fn try_wait(this mut &) -> bool
  {
    return std::atomic_load(&this.value, std::memory_order::relaxed) == 0;
  }

  pub fn try_wait_until(this mut &, u64 abstime) -> bool
  {
    if (std::atomic_load(&this.value, std::memory_order::relaxed) != 0)
    {
      var guard = std::lock_guard(&mut cpu::irqlock, &mut this.spinlock);

      if (std::atomic_load(&this.value, std::memory_order::acquire) == 0)
        return true;

      if (var rc = this.waiters.wait_until(&mut this.spinlock, abstime); rc < 0)
        return false;
    }

    return true;
  }

  pub fn acquire(this mut &) -> void
  {
    std::atomic_add(&this.value, 1, std::memory_order::release);
  }

  pub fn release(this mut &) -> void
  {
    if (std::atomic_sub(&this.value, 1, std::memory_order::release) == 1)
    {
      var guard = std::lock_guard(&mut cpu::irqlock, &mut this.spinlock);

      this.waiters.wake_all();
    }
  }

  pub fn reset(this mut &) -> void
  {
    std::atomic_store(&this.value, 0);
  }

  pub latch(u32 value)
    : value(value)
  {
  }

  pub latch() = default;
  pub latch(#latch &) = default;
  pub ~latch() = default;

  std::spin_lock spinlock;
  wait_queue waiters;
}
