pub struct input_t
{
  netdev mut *link;
  u16 rxqid;

  input_t mut *next;

  worker mut *worker;
  worker mut *last_worker;

  latch barrier;

  pub input_t() = default;
  pub input_t(#input_t &) = default;
  pub ~input_t() = default;
}

pub struct output_t
{
  netdev mut *link;

  output_t mut *next;

  worker mut *worker;
  worker mut *last_worker;

  latch barrier;

  pub output_t() = default;
  pub output_t(#output_t &) = default;
  pub ~output_t() = default;
}

pub struct timeout_t
{
  pub enum flags
  {
    pub const nosync = 0x1;
  }

  pub u64 flags;

  u64 deadline;
  pub fn (*callback)(timeout_t mut *) -> void;

  timeout_t mut *next;
  timeout_t mut * mut *prev;

  worker mut *worker;
  worker mut *last_worker;

  latch barrier;

  pub fn scheduled(this &) -> bool
  {
    return !!this.worker;
  }

  pub fn deadline(this &) -> u64
  {
    return this.deadline;
  }

  pub timeout_t() = default;
  pub timeout_t(#timeout_t &) = default;
  pub ~timeout_t() = default;
}

struct worker
{
  std::spin_lock lock;

  input_t mut *inputhead;
  input_t mut * mut *inputlast;

  output_t mut *outputhead;
  output_t mut * mut *outputlast;

  timeout_t mut *timers;
  timeout_t mut * mut *timerslast;

  semaphore doorbell;
  thread mut *knetworkd;

  worker() = default;
  worker(#worker &) = default;
  ~worker() = default;
}

struct network_stack
{
  mutex lock;

  pub ip::state ip;
  pub udp::state udp;
  pub tcp::state tcp;

  pub net::route_table routes;

  pub Rc<net::lo> lo;
  pub Rc<net::ctldev> ctl;

  std::vector<netlink::route mut *> listeners;

  worker[MAX_CPU_COUNT] workers;

  fn instance() -> network_stack mut &
  {
    static instance = #network_stack();

    return &instance;
  }

  network_stack() = default;
  network_stack(#network_stack &) = default;
  ~network_stack() = default;
}

pub fn stack()
{
  return &network_stack::instance;
}

pub fn routes()
{
  return &network_stack::instance.routes;
}

pub fn enqueue(input_t mut *dpc, netdev mut *link, u16 rxqid) -> void
{
  std::assert(platform::interrupts_disabled);

  var mut &worker = stack.workers[cast<usize>(cpu::id)];

  if (dpc.worker)
    return;

  dpc.link = link;
  dpc.rxqid = rxqid;
  dpc.worker = &worker;
  dpc.last_worker = &worker;
  dpc.barrier.acquire();

  if (!worker.inputhead)
    worker.inputlast = &worker.inputhead;

  *worker.inputlast = dpc;
  worker.inputlast = &dpc.next;

  worker.doorbell.release();
}

pub fn sync(input_t mut *dpc) -> void
{
  dpc.barrier.wait();
}

pub fn enqueue(output_t mut *dpc, netdev mut *link) -> void
{
  var mut &worker = stack.workers[cast<usize>(cpu::id)];

  if (!std::atomic_cmpxchg_strong(&dpc.worker, null, &worker))
    return;

  var guard = std::lock_guard(&mut cpu::irqlock);

  dpc.link = link;
  dpc.worker = &worker;
  dpc.last_worker = &worker;
  dpc.barrier.acquire();

  if (!worker.outputhead)
    worker.outputlast = &worker.outputhead;

  *worker.outputlast = dpc;
  worker.outputlast = &dpc.next;

  worker.doorbell.release();
}

pub fn sync(output_t mut *dpc) -> void
{
  dpc.barrier.wait();
}

pub fn enqueue(timeout_t mut *dpc, u64 deadline) -> void
{
  std::assert(!dpc.worker);

  var mut &worker = stack.workers[cast<usize>(cpu::id)];

  var guard = std::lock_guard(&mut cpu::irqlock, &mut worker.lock);

  dpc.deadline = deadline;
  dpc.worker = &worker;
  dpc.last_worker = &worker;
  dpc.barrier.acquire();

  if (!worker.timers)
    worker.timerslast = &worker.timers;

  var insertpos = &worker.timers;

  while (*insertpos && insertpos.deadline < deadline)
    insertpos = &insertpos.next;

  dpc.next = *insertpos;

  if (dpc.next)
    dpc.prev = std::exchange(&mut dpc.next.prev, &dpc.next);
  else
    dpc.prev = std::exchange(&mut worker.timerslast, &dpc.next);

  *insertpos = dpc;

  if (worker.timers == dpc)
    worker.doorbell.release();
}

pub fn cancel(timeout_t mut *dpc) -> void
{
  for (;;)
  {
    var worker = std::atomic_load(&dpc.worker);

    if (!worker)
      return;

    var guard = std::lock_guard(&mut cpu::irqlock, &mut worker.lock);

    if (dpc.worker != worker)
      continue;

    *dpc.prev = dpc.next;

    if (dpc.next)
      dpc.next.prev = dpc.prev;
    else
      worker.timerslast = dpc.prev;

    dpc.barrier.release();

    dpc.worker = null;
  }
}

pub fn sync(timeout_t mut *dpc) -> void
{
  dpc.barrier.wait();
}

fn lock(worker mut *worker) -> void
{
  platform::disable_interrupts();

  worker.lock.lock();
}

fn pop(input_t mut * mut &inputhead) -> input_t mut *
{
  var dpc = inputhead;

  inputhead = std::exchange(&mut dpc.next, null);

  dpc.worker = null;

  return dpc;
}

fn pop(output_t mut * mut &outputhead) -> output_t mut *
{
  var dpc = outputhead;

  outputhead = std::exchange(&mut dpc.next, null);

  dpc.worker = null;

  return dpc;
}

fn pop(timeout_t mut * mut &timers) -> timeout_t mut *
{
  var dpc = timers;

  if (dpc.next)
    dpc.next.prev = &timers;

  timers = std::exchange(&mut dpc.next, null);

  dpc.worker = null;

  return dpc;
}

fn unlock(worker mut *worker) -> void
{
  worker.lock.unlock();

  platform::enable_interrupts();
}

fn knetworkd(worker mut *worker) -> void
{
  for (;;)
  {
    var budget = 8;

    lock(worker);

    for (; budget > 4; budget -= 1)
    {
      if (!worker.inputhead)
        break;

      var dpc = pop(&mut worker.inputhead);

      var link = dpc.link;
      var rxqid = dpc.rxqid;

      unlock(worker);

      var budget = 32;

      for (; budget > 0; budget -= 1)
      {
        var pkt = net::packet();

        if (!link.retrieve(rxqid, &mut pkt))
          break;

        receive(link, &mut pkt);
      }

      link.refill(rxqid);

      lock(worker);

      if (budget == 0)
      {
        enqueue(dpc, link, rxqid);
      }

      dpc.barrier.release();
    }

    for (; budget > 0; budget -= 1)
    {
      if (!worker.outputhead)
        break;

      var dpc = pop(&mut worker.outputhead);

      var link = dpc.link;

      unlock(worker);

      var budget = 32;

      for (; budget > 0; budget -= 1)
      {
        if (link.qdisc.run(link) <= cast(0))
          break;
      }

      for (; budget > 0; budget -= 1)
      {
        var pkt = net::packet();

        if (!link.qdisc.dequeue(&mut pkt))
          break;
      }

      lock(worker);

      if (link.qdisc.len != 0)
      {
        enqueue(dpc, link);
      }

      dpc.barrier.release();
    }

    unlock(worker);

    var now = cpu::system_time;

    lock(worker);

    for (;;)
    {
      if (!worker.timers || now < worker.timers.deadline)
        break;

      var dpc = pop(&mut worker.timers);

      var flags = dpc.flags;
      var callback = dpc.callback;

      unlock(worker);

      callback(dpc);

      lock(worker);

      if (flags & timeout_t::flags::nosync == 0)
        dpc.barrier.release();
    }

    var waketime = ~0;

    if (worker.timers)
      waketime = worker.timers.deadline;

    unlock(worker);

    if (budget == 0 || waketime < now + 1_000_000)
      waketime = now + 1_000_000;

    worker.doorbell.try_wait_until(waketime);
  }
}

pub fn open(netdev mut *link, vfs::fd mut &fd, process mut *process, u64 flags, u32 mode) -> net::result
{
  return link.open(&mut fd, process, flags, mode);
}

pub fn transmit(netdev mut *link, Rc<io::iocb> mut &cb, net::packet mut &pkt) -> void
{
  if (var result = link.qdisc.enqueue(&mut cb, &mut pkt); !result)
    io::complete(&mut cb, result);

  switch (link.type)
  {
    case loop:
      net::enqueue(&link.qdisc.dpc, link);

    else:
      link.qdisc.run(link);
  }
}

pub fn receive(netdev mut *link, net::packet mut &pkt) -> net::result
{
  var rx = rx();

  rx.timestamp = cpu::system_time;

  switch (pkt.type)
  {
    case eth:
      if (var result = ethernet::deframe(link, &mut rx, &mut pkt); !result)
        return result;
  }

  rx.inhdr = pkt.start;

  switch (pkt.type)
  {
    case arp:
      if (var result = arp::receive(link, &mut pkt); !result)
        return result;

    //case ipv4:
    //  if (var result = ipv4::receive(link, &mut pkt); !result)
    //    return result;

    case ipv6:
      if (var result = ipv6::receive(link, &mut rx, &mut pkt); !result)
        return result;
  }

  switch (pkt.type)
  {
    case udp:
      if (var result = udp::receive(link, &mut rx, &mut pkt); !result)
        return result;

    case tcp:
      if (var result = tcp::receive(link, &mut rx, &mut pkt); !result)
        return result;
  }

  return ok;
}

pub fn up_link(netdev mut *link) -> void
{
  var guard = std::lock_guard(&mut stack.lock);

  if (std::atomic_or(&link.flags, net::flags::up) & net::flags::up == net::flags::up)
    return;

  link.startup();

  switch (link.type)
  {
    case loop:
      link.ipv6.add_addr(in6addr_loopback, 128);

    case ether:
      ipv6::configure(link);
  }
}

pub fn down_link(netdev mut *link) -> void
{
  var guard = std::lock_guard(&mut stack.lock);

  if (std::atomic_and(&link.flags, ~net::flags::up) & net::flags::up != net::flags::up)
    return;

  ipv6::unconfigure(link);

  link.shutdown();
}

pub fn resolve_route(route *route, inaddr &dst_ip, Rc<io::iocb> mut &cb, inaddr mut &src_ip, hwaddr mut &dst) -> net::result
{
  var nexthop = dst_ip;

  if (route.nexthop)
    nexthop = route.nexthop;

  switch (route.link.type)
  {
    case loop:

      if (src_ip.is_unspecified)
      {
        src_ip = dst_ip;
      }

    case ether:

      if (src_ip.is_unspecified)
      {
        src_ip = inaddr::in6();

        if (var result = route.link.ipv6.select_source(dst_ip.in6, &mut src_ip.in6); !result)
          return result;
      }

      if (var result = route.link.ipv6.resolve_neighbour(route.link, &mut cb, nexthop.in6, src_ip.in6, &mut dst); !result)
        return result;
  }

  return ok;
}

pub fn add_listener(netlink::route mut *node) -> void
{
  var guard = std::lock_guard(&mut stack.lock);

  stack.listeners.push_back(node);
}

pub fn remove_listener(netlink::route mut *node) -> void
{
  var guard = std::lock_guard(&mut stack.lock);

  stack.listeners.erase(node);
}

pub fn enumerate(var &&callback) -> void
{
  dev::enumerate(|id, device| [callback] {
    switch (device)
    {
      case netdev[dev]:
        callback(id, dev);
    }
  });
}

pub fn initialise() -> void
{
  stack.ctl = chr::chrdev::create<ctldev>();

  dev::register(dev::dev_t(), stack.ctl);

  stack.lo = net::netdev::create<lo>();

  dev::register(dev::dev_t(), stack.lo);

  if (var result = ip::initialise(&mut stack.ip); !result)
    std::panic("bad_ip_init");

  if (var result = udp::initialise(&mut stack.udp); !result)
    std::panic("bad_udp_init");

  if (var result = tcp::initialise(&mut stack.tcp); !result)
    std::panic("bad_tcp_init");

  for (var i = 0; i < sys::cpu_count; ++i)
  {
    var mut &worker = stack.workers[i];

    worker.knetworkd = create_thread(process::current, &cast<(worker mut *) -> void>(knetworkd), &worker);

    scheduler::enqueue_pinned(cast<int>(i), worker.knetworkd, thread::priority::io);
  }
}
