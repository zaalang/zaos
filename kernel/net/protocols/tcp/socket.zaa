//
// tcp socket
//

import std.stdio;
import vm;
import io;
import cpu;
import net.in;
import net.packet;
import net.result;
import net.protocols.ip as ip;
import net.protocols.ip.socket as ip.socket;
import net.protocols.tcp as tcp : tcp_header, tcp_state, tcp_seq, tcp_flags;
import net.protocols.tcp.window as tcp.window;
import mutex as _ : mutex;
import socket as _ : socket, sockaddr, sockaddr_storage, ctrlhdr, ctrlattr, ancillary_data;
import support.rc : Rc;

using net::hwaddr;
using net::inaddr;
using ip::sockaddr_in4;
using ip::sockaddr_in6;

enum cta
{
  const pktsrc = (41, 1);
  const pktdst = (41, 2);
  const timestamp = (41, 3);
  const ipv6_hoplimit = (41, 52);
  const ipv6_pathmtu = (41, 62);
}

enum sio
{
  const soerror = 0x80030004;
  const getsockname = 0x8003001b;
  const getpeername = 0x8003001c;
}

const TCP_DEFAULT_WINDOW = 65535;
const TCP_DEFAULT_MAX_SEGMENT_SIZE = 536;

const TCP_MAX_RETRIES = 5;
const TCP_SND_LOW_WATER_MARK = 256;

const TCP_MIN_RTO = 200_000_000;
const TCP_MAX_RTO = 60_000_000_000;
const TCP_SYN_RTO = 1_000_000_000;
const TCP_ACK_DELAY = 100_000_000;
const TCP_2MSL_TIME = 60_000_000_000;

pub struct tcb
{
  mutex lock;

  i32 soerror;

  tcp_state state;

  pub inaddr local_ip;
  pub inaddr remote_ip;

  pub u16 local_port;
  pub u16 remote_port;

  tcp::window snd_q;
  tcp::window rcv_q;

  tcp_seq iss;        // initial send sequence number
  tcp_seq snd_una;    // send unacknowledged
  tcp_seq snd_nxt;    // send next
  tcp_seq snd_max;    // max send next
  usize snd_wnd;      // send window
  tcp_seq snd_up;     // send urgent pointer
  tcp_seq snd_wl1;    // last window update seq
  tcp_seq snd_wl2;    // last window update ack
  bool snd_ack;       // send next ack

  tcp_seq irs;        // initial receive sequence number
  tcp_seq rcv_nxt;    // receive next
  usize rcv_wnd;      // receive window
  tcp_seq rcv_up;     // receive urgent pointer

  u64 rto;            // retransmission timeout
  int rtc;            // retransmission count

  usize mss;          // maximum segment size

  u64 rtt_start;      // roundtrip-time start
  tcp_seq rtt_seq;    // roundtrip-time start sequence
  i32 rtt_smothed;
  i32 rtt_variation;

  int dac;            // duplicate ack count

  net::timeout_t connect_timer;
  net::timeout_t delayedack_timer;
  net::timeout_t retransmit_timer;
  net::timeout_t timewait_timer;

  net::packet_allocator pkthdr;

  io::response readable;
  io::response writeable;
  io::response routeable;
  io::response queryable;

  pub fn ref(this mut &) -> void
  {
    std::atomic_add(&this.refcnt, 1);
  }

  pub fn try_ref(this mut &) -> bool
  {
    for (;;)
    {
      var refcnt = std::volatile_load(&this.refcnt);

      if (refcnt == 0)
        return false;

      if (std::atomic_cmpxchg_weak(&this.refcnt, refcnt, refcnt + 1))
        break;
    }

    return true;
  }

  pub fn unref(this mut &) -> void
  {
    if (std::atomic_sub(&this.refcnt, 1) == 1)
      destroy(&this);
  }

  pub fn refcnt(this &) -> i32
  {
    return std::atomic_load(&this.refcnt);
  }

  pub tcb() = default;
  pub ~tcb() = default;

  i32 refcnt;
}

fn init(tcb mut &tcb) -> void
{
  var iss = cast<u32>((cpu::system_time >> 4) & 0xffffffff);

  tcb.iss = iss;
  tcb.snd_una = iss;
  tcb.snd_nxt = iss;
  tcb.snd_max = iss;
  tcb.snd_q.resize(tcb.iss + 1, TCP_DEFAULT_WINDOW);

  tcb.irs = 0;
  tcb.rcv_nxt = 0;
  tcb.rcv_wnd = 16384;
  tcb.rto = TCP_SYN_RTO;

  tcb.mss = TCP_DEFAULT_MAX_SEGMENT_SIZE;

  tcb.connect_timer.callback = &cast<(net::timeout_t mut *) -> void>(connect_timer);
  tcb.delayedack_timer.callback = &cast<(net::timeout_t mut *) -> void>(delayedack_timer);
  tcb.retransmit_timer.callback = &cast<(net::timeout_t mut *) -> void>(retransmit_timer);

  tcb.timewait_timer.flags |= net::timeout_t::flags::nosync;
  tcb.timewait_timer.callback = &cast<(net::timeout_t mut *) -> void>(timewait_timer);
}

fn send(tcb mut &tcb, tcp_seq mut &snd_nxt, u16 flags, usize length) -> net::result
{
  var route = net::routes.find(tcb.remote_ip);

  if (!route)
    return host_unreachable;

  var dst = net::hwaddr();

  if (var result = net::resolve_route(route, tcb.remote_ip, &mut tcb.routeable.cb, &mut tcb.local_ip, &mut dst); !result)
    return result;

  var pkt = tcb.pkthdr.allocate(256);

  tcb.snd_q.foreach_packet_in(snd_nxt, length, |packet, start, bytes| {
    pkt.append(packet.iovec, packet.start + start, bytes);
  });

  var response = io::response();

  io::initiate(&mut response.cb, 1);

  tcp::send(route.link, &mut response.cb, tcb.remote_port, tcb.local_port, snd_nxt, tcb.rcv_nxt, flags, tcb.rcv_wnd, tcb.remote_ip.in6, tcb.local_ip.in6, dst, route.link.hwaddr, &mut pkt);

  snd_nxt += length;

  if (flags & tcp_flags::syn != 0)
    snd_nxt += 1;

  if (flags & tcp_flags::fin != 0)
    snd_nxt += 1;

  if (tcb.snd_max < snd_nxt)
    tcb.snd_max = snd_nxt;

  tcb.snd_ack = false;

  return ok;
}

fn acknowledge(tcb mut &tcb, tcp_seq acknowledge) -> void
{
  std::assert(tcb.snd_una < acknowledge && acknowledge <= tcb.snd_max);

  tcb.snd_una = acknowledge;

  if (tcb.snd_nxt < tcb.snd_una)
    tcb.snd_nxt = tcb.snd_una;

  tcb.snd_q.erase(tcb.snd_q.head, acknowledge);

  net::cancel(&tcb.retransmit_timer);

  if (tcb.snd_una != tcb.snd_max)
    net::enqueue(&tcb.retransmit_timer, cpu::system_time + tcb.rto);

  if (!tcb.writeable.ready)
    io::complete(&mut tcb.writeable.cb, 0);

  tcb.dac = 0;
  tcb.rtc = 0;
}

fn duplicate_acknowledge(tcb mut &tcb, tcp_seq acknowledge) -> void
{
  tcb.dac += 1;

  if (tcb.dac == 3)
  {
    tcb.snd_nxt = acknowledge;
  }
}

fn update_roundtrip_time(tcb mut &tcb, tcp_seq acknowledge) -> void
{
  if (tcb.rtt_start == 0)
    return;

  if (acknowledge <= tcb.rtt_seq)
    return;

  var rtt = cast<i32>((cpu::system_time - tcb.rtt_start) >> 16);

  if (tcb.rtt_smothed == 0)
  {
    tcb.rtt_smothed = rtt;
		tcb.rtt_variation = rtt / 2;
  }
  else
  {
    tcb.rtt_variation += (std::absdiff(tcb.rtt_smothed, rtt) - tcb.rtt_variation) / 4;
		tcb.rtt_smothed += (rtt - tcb.rtt_smothed) / 8;
  }

  var rto = std::max(0, tcb.rtt_smothed) + std::max(15258/5, 4 * tcb.rtt_variation);

  tcb.rto = std::clamp(cast<u64>(rto) << 16, TCP_MIN_RTO, TCP_MAX_RTO);

  tcb.rtt_start = 0;
}

fn disconnect(tcb mut &tcb, net::result status) -> void
{
  tcb.state = tcp_state::closed;

  tcb.soerror = cast<i32>(status);

  if (!tcb.queryable.ready)
    io::complete(&mut tcb.queryable.cb, 0);

  if (!tcb.readable.ready)
    io::complete(&mut tcb.readable.cb, 0);

  if (!tcb.writeable.ready)
    io::complete(&mut tcb.writeable.cb, 0);

  net::enqueue(&tcb.timewait_timer, cpu::system_time);
}

fn acceptable_incomming_sequence(tcb &tcb, tcp_seq sequence, usize length) -> bool
{
  if (length == 0 && tcb.rcv_wnd == 0)
    return sequence == tcb.rcv_nxt;

  if (length == 0 && tcb.rcv_wnd > 0)
    return sequence >= tcb.rcv_nxt && sequence < tcb.rcv_nxt + tcb.rcv_wnd;

  if (length > 0 && tcb.rcv_wnd == 0)
    return false;

  if (length > 0 && tcb.rcv_wnd > 0)
    return (sequence >= tcb.rcv_nxt && sequence < tcb.rcv_nxt + tcb.rcv_wnd) || (sequence + (length - 1) >= tcb.rcv_nxt && sequence + (length - 1) < tcb.rcv_nxt + tcb.rcv_wnd);

  return false;
}

fn acceptable_incomming_acknowledge(tcb &tcb, tcp_seq acknowledge) -> bool
{
  if (tcb.snd_una < acknowledge && acknowledge <= tcb.snd_max)
    return true;

  return false;
}

fn input(tcb mut &tcb, net::netdev mut *link, net::rx &rx, tcp_header *hdr, net::packet mut &pkt) -> net::result
{
  var flags = hdr.flags;
  var sequence = tcp_seq(std::be_to_native(hdr.sequence));
  var acknowledge = tcp_seq(std::be_to_native(hdr.acknowledge));
  var window = cast<usize>(std::be_to_native(hdr.window));

  switch (tcb.state)
  {
    case closed:

      if (flags & tcp_flags::rst == 0)
        tcp::send_reset_reply(link, rx, hdr, pkt);

      return ok;

    case listen:
      std::panic("not implemented");

    case syn_sent:

      if (flags & tcp_flags::ack != 0)
      {
        if (acknowledge <= tcb.iss || acknowledge > tcb.snd_max)
        {
          if (flags & tcp_flags::rst == 0)
            tcp::send_reset_reply(link, rx, hdr, pkt);

          return ok;
        }
      }

      if (flags & tcp_flags::rst != 0)
      {
        if (flags & tcp_flags::ack != 0)
          disconnect(&mut tcb, net::result::connection_refused);

        return ok;
      }

      if (flags & tcp_flags::syn != 0)
      {
        tcb.irs = sequence;
        tcb.rcv_nxt = sequence + 1;
        tcb.rcv_q.resize(tcb.irs + 1, TCP_DEFAULT_WINDOW);
        tcb.rcv_wnd = tcb.rcv_q.remaining;

        tcb.snd_wl1 = sequence;
        tcb.snd_wl2 = acknowledge;
        tcb.snd_wnd = window;
        tcb.snd_ack = true;

        if (flags & tcp_flags::ack != 0)
          tcb.snd_una = acknowledge;

        if (tcb.snd_una > tcb.iss)
          tcb.state = tcp_state::established;
        else
          tcb.state = tcp_state::syn_received;

        if (tcb.state == tcp_state::established)
          io::complete(&mut tcb.writeable.cb, 0);

        net::cancel(&tcb.connect_timer);
      }

      if (flags & (tcp_flags::syn | tcp_flags::rst) == 0)
        return ok;

      sequence += 1;

    case syn_received:
    case established:
    case close_wait:
    case last_ack:
    case fin_wait_1:
    case fin_wait_2:
    case closing:
    case time_wait:

      if (!acceptable_incomming_sequence(tcb, sequence, pkt.length))
      {
        if (flags & tcp_flags::rst == 0)
          send(&mut tcb, &mut tcb.snd_nxt, tcp_flags::ack, 0);

        return ok;
      }

      if (flags & tcp_flags::rst != 0)
      {
        if (tcb.rcv_nxt <= sequence && sequence < tcb.rcv_nxt + tcb.rcv_wnd)
        {
          switch (tcb.state)
          {
            case syn_received:
              disconnect(&mut tcb, net::result::connection_refused);

            case closing:
            case last_ack:
              disconnect(&mut tcb, net::result::not_connected);

            case established:
            case close_wait:
            case fin_wait_1:
            case fin_wait_2:
              disconnect(&mut tcb, net::result::connection_reset);
          }
        }

        return ok;
      }

      if (flags & tcp_flags::syn != 0)
      {
        tcp::send_reset_reply(link, rx, hdr, pkt);

        return ok;
      }
  }

  if (sequence < tcb.rcv_nxt)
  {
    var advance = tcb.rcv_nxt - sequence;

    if (advance > pkt.length || (advance == pkt.length && flags & tcp_flags::fin == 0))
    {
      flags &= ~tcp_flags::fin;

      advance = pkt.length;
    }

    pkt.strip(advance);

    sequence += advance;
  }

  if (sequence + pkt.length > tcb.rcv_nxt + tcb.rcv_wnd)
  {
    var retract = (sequence + pkt.length) - (tcb.rcv_nxt + tcb.rcv_wnd);

    if (flags & tcp_flags::fin != 0)
      retract -= 1;

    flags &= ~(tcp_flags::fin | tcp_flags::psh);

    if (retract > pkt.length)
    {
      retract = pkt.length;
    }

    pkt.trim(pkt.length - retract);
  }

  if (sequence != tcb.rcv_nxt)
    tcb.snd_ack = true;

  if (flags & tcp_flags::ack != 0)
  {
    switch (tcb.state)
    {
      case syn_received:
        if (!acceptable_incomming_acknowledge(tcb, acknowledge))
        {
          tcp::send_reset_reply(link, rx, hdr, pkt);

          return ok;
        }

        tcb.snd_wl1 = sequence;
        tcb.snd_wl2 = acknowledge;
        tcb.snd_wnd = window;

        tcb.state = tcp_state::established;

        io::complete(&mut tcb.writeable.cb, 0);

      case established:
      case close_wait:
      case last_ack:
      case fin_wait_1:
      case fin_wait_2:
      case closing:
      case time_wait:

        if (acknowledge > tcb.snd_max)
          tcb.snd_ack = true;

        if (acknowledge == tcb.snd_una && tcb.snd_una != tcb.snd_max)
        {
          if (pkt.length == 0 && window == tcb.snd_wnd && flags & tcp_flags::fin == 0)
          {
            duplicate_acknowledge(&mut tcb, acknowledge);
          }
        }

        if (tcb.snd_una <= acknowledge && acknowledge <= tcb.snd_max)
        {
          if (tcb.snd_wl1 < sequence || (tcb.snd_wl1 == sequence && tcb.snd_wl2 <= acknowledge))
          {
            tcb.snd_wnd = window;
            tcb.snd_wl1 = sequence;
            tcb.snd_wl2 = acknowledge;
          }
        }
    }

    if (acceptable_incomming_acknowledge(tcb, acknowledge))
    {
      acknowledge(&mut tcb, acknowledge);

      if (acknowledge > tcb.snd_q.tail)
      {
        switch (tcb.state)
        {
          case fin_wait_1:
            tcb.state = tcp_state::fin_wait_2;

          case closing:
            tcb.state = tcp_state::time_wait;
            net::enqueue(&tcb.timewait_timer, cpu::system_time + TCP_2MSL_TIME);

          case last_ack:
            disconnect(&mut tcb, net::result::ok);
        }
      }

      update_roundtrip_time(&mut tcb, acknowledge);
    }
  }

	if (flags & tcp_flags::urg != 0)
  {
  }

  var length = pkt.length;

  tcb.rcv_q.insert(sequence, &mut pkt);

  tcb.rcv_nxt = tcb.rcv_q.head + tcb.rcv_q.contiguous;

  if (tcb.rcv_nxt != tcb.rcv_q.tail)
    flags &= ~tcp_flags::fin;

  tcb.rcv_wnd -= std::min(tcb.rcv_wnd, length);

  if (flags & tcp_flags::fin != 0)
  {
    tcb.rcv_nxt += 1;

    switch (tcb.state)
    {
      case syn_received:
      case established:
        tcb.state = tcp_state::close_wait;

        if (!tcb.readable.ready)
          io::complete(&mut tcb.readable.cb, 0);

      case fin_wait_1:
        tcb.state = tcp_state::closing;

      case fin_wait_2:
        tcb.state = tcp_state::time_wait;
        net::enqueue(&tcb.timewait_timer, cpu::system_time + TCP_2MSL_TIME);

      case time_wait:
        net::cancel(&tcb.timewait_timer);
        net::cancel(&tcb.retransmit_timer);
        net::enqueue(&tcb.timewait_timer, cpu::system_time + TCP_2MSL_TIME);
    }

    tcb.snd_ack = true;
  }

  if (length > 0 || flags & tcp_flags::fin != 0)
  {
    if (!tcb.snd_ack && !tcb.delayedack_timer.scheduled)
      net::enqueue(&tcb.delayedack_timer, cpu::system_time + TCP_ACK_DELAY);
  }

  if (tcb.rcv_q.contiguous != 0)
  {
    if (!tcb.readable.ready)
      io::complete(&mut tcb.readable.cb, 0);
  }

  output(&mut tcb);

  return ok;
}

fn should_send_now(tcb &tcb, u16 flags, usize length) -> bool
{
  if (tcb.snd_ack)
    return true;

  if (flags & ~tcp_flags::ack != 0)
    return true;

  if (length != 0)
  {
    // Retransmit
    if (tcb.snd_nxt == tcb.snd_max)
      return true;

    // Nagle
    if (tcb.snd_wnd >= tcb.mss && length >= tcb.mss)
      return true;

    if (tcb.snd_una == tcb.snd_max)
      return true;
  }

  return false;
}

fn output(tcb mut &tcb) -> net::result
{
  var flags = 0;

  switch (tcb.state)
  {
    case syn_received:
      flags = tcp_flags::syn | tcp_flags::ack;

    case established:
    case close_wait:
    case fin_wait_2:
    case time_wait:
      flags = tcp_flags::ack;

    case last_ack:
    case fin_wait_1:
    case closing:
      flags = tcp_flags::fin | tcp_flags::ack;
  }

  for (;;)
  {
    var flags = flags;
    var sequence = tcb.snd_nxt;

    var flight = tcb.snd_max - tcb.snd_una;
    var offset = tcb.snd_nxt - tcb.snd_q.head;
    var window = std::max(tcb.snd_wnd, offset) - offset;
    var length = std::min(std::max(tcb.snd_q.contiguous, offset) - offset, window);

    length = std::min(length, tcb.mss);

    if (sequence + length != tcb.snd_q.tail)
      flags &= ~tcp_flags::fin;

    if (sequence + length == tcb.snd_q.tail && length != 0)
      flags |= tcp_flags::psh;

    if (!should_send_now(tcb, flags, length))
      break;

    send(&mut tcb, &mut tcb.snd_nxt, flags, length);

    if (tcb.snd_nxt == tcb.snd_max && tcb.rtt_start == 0)
    {
      tcb.rtt_seq = sequence;
      tcb.rtt_start = cpu::system_time;
    }

    if (sequence == tcb.snd_una && !tcb.retransmit_timer.scheduled)
      net::enqueue(&tcb.retransmit_timer, cpu::system_time + tcb.rto);

    if (flags & tcp_flags::ack)
      net::cancel(&tcb.delayedack_timer);

    if (sequence == tcb.snd_nxt || length == 0)
      break;

    if (tcb.snd_nxt != tcb.snd_max)
      break;
  }

  return ok;
}

fn connect_timer(net::timeout_t mut *timer) -> void
{
  var mut &tcb = *cast<tcb mut *>(cast<uintptr>(timer) - offsetof(tcb::connect_timer));

  var guard = std::lock_guard(&mut tcb.lock);

  if (tcb.state != tcp_state::syn_sent)
    return;

  tcb.snd_nxt = tcb.snd_una;
  tcb.rto = std::min(tcb.rto + TCP_SYN_RTO, TCP_MAX_RTO);

  send(&mut tcb, &mut tcb.snd_nxt, tcp_flags::syn, 0);

  net::enqueue(timer, cpu::system_time + tcb.rto);
}

fn delayedack_timer(net::timeout_t mut *timer) -> void
{
  var mut &tcb = *cast<tcb mut *>(cast<uintptr>(timer) - offsetof(tcb::delayedack_timer));

  var guard = std::lock_guard(&mut tcb.lock);

  if (tcb.state != tcp_state::established)
    return;

  send(&mut tcb, &mut tcb.snd_una, tcp_flags::ack, 0);
}

fn retransmit_timer(net::timeout_t mut *timer) -> void
{
  var mut &tcb = *cast<tcb mut *>(cast<uintptr>(timer) - offsetof(tcb::retransmit_timer));

  var guard = std::lock_guard(&mut tcb.lock);

  if (tcb.retransmit_timer.scheduled)
    return;

  if (tcb.state == tcp_state::closed)
    return;

  if (tcb.rtc > TCP_MAX_RETRIES)
  {
    if (tcb.state != tcp_state::time_wait)
      disconnect(&mut tcb, net::result::timed_out);

    return;
  }

  tcb.dac = 0;
  tcb.rtc += 1;
  tcb.rto = std::min(2 * tcb.rto, TCP_MAX_RTO);

  tcb.snd_nxt = tcb.snd_una;

  output(&mut tcb);
}

fn timewait_timer(net::timeout_t mut *timer) -> void
{
  var mut &tcb = *cast<tcb mut *>(cast<uintptr>(timer) - offsetof(tcb::timewait_timer));

  tcb.lock.lock();

  tcb.state = tcp_state::closed;

  net::cancel(&tcb.connect_timer);
  net::cancel(&tcb.delayedack_timer);
  net::cancel(&tcb.retransmit_timer);
  net::cancel(&tcb.timewait_timer);

  tcb.lock.unlock();

  tcb.unref();
}

fn destroy(tcb mut *tcb) -> void
{
  std::assert(tcb.state == tcp_state::closed);
  std::assert(!tcb.connect_timer.scheduled);
  std::assert(!tcb.retransmit_timer.scheduled);
  std::assert(!tcb.timewait_timer.scheduled);

  net::stack.tcp.unbind(tcb);

  net::sync(&tcb.connect_timer);
  net::sync(&tcb.delayedack_timer);
  net::sync(&tcb.retransmit_timer);

  tcb.pkthdr.free();

  std::allocator::delete(tcb);
}

pub fn deliver(tcb mut *tcb, net::netdev mut *link, net::rx &rx, tcp_header *hdr, net::packet mut &pkt) -> net::result
{
  var guard = std::lock_guard(&mut tcb.lock);

  input(&mut *tcb, link, rx, hdr, &mut pkt);

  return cast(1);
}

pub fn deliver_error(tcb mut *tcb, net::result status) -> net::result
{
  var guard = std::lock_guard(&mut tcb.lock);

  tcb.soerror = cast<i32>(status);

  if (!tcb.queryable.ready)
    io::complete(&mut tcb.queryable.cb, 0);

  return ok;
}

pub fn open(socket mut *socket) -> net::result
{
  socket.protocol = IPPROTO_TCP;

  var tcb = std::allocator::new<tcb>();

  tcb.readable = socket.readable;
  tcb.routeable = socket.writeable;
  tcb.queryable = socket.queryable;

  std::atomic_add(&tcb.refcnt, 1);

  socket.state = tcb;

  return ok;
}

pub fn bind(socket mut *socket, sockaddr *addr, usize alen) -> net::result
{
  var mut &tcb = *cast<tcb mut *>(socket.state);

  var guard = std::lock_guard(&mut tcb.lock);

  if (socket.sockname.ss_family != 0)
    return already_connected;

  if (var result = net::stack.tcp.bind(socket, &tcb, addr, alen); !result)
    return result;

  return ok;
}

pub fn connect(socket mut *socket, sockaddr *addr, usize alen) -> net::result
{
  var mut &tcb = *cast<tcb mut *>(socket.state);

  var guard = std::lock_guard(&mut tcb.lock);

  switch (tcb.state)
  {
    case closed:
      ;

    case listen:
      ;

    case established:
      return already_connected;

    else:
      return already_in_progress;
  }

  if (socket.sockname.ss_family == 0)
    return address_not_available;

  init(&mut tcb);

  if (var result = net::stack.tcp.connect(socket, &tcb, addr, alen); !result)
    return result;

  if (var result = send(&mut tcb, &mut tcb.snd_nxt, tcp_flags::syn, 0); !result)
    return result;

  tcb.state = tcp_state::syn_sent;

  net::enqueue(&tcb.connect_timer, cpu::system_time + tcb.rto);

  tcb.writeable = socket.writeable;

  io::initiate(&mut tcb.writeable.cb, 1);

  std::atomic_add(&tcb.refcnt, 1);

  return in_progress;
}

pub fn ioctl(socket mut *socket, u32 op, vm::iovec &iovec) -> net::result
{
  var mut &tcb = *cast<tcb mut *>(socket.state);

  var guard = std::lock_guard(&mut tcb.lock);

  switch (op)
  {
    case sio::soerror:

      if (var result = vm::memcpy(iovec, 0, &tcb.soerror, sizeof<i32>); !result)
        return cast(result);

      tcb.soerror = cast(0);

      return cast(sizeof<i32>);

    case sio::getsockname:

      if (var result = vm::memcpy(iovec, 0, &socket.sockname, sizeof<sockaddr_in6>); !result)
        return cast(result);

      return cast(sizeof<sockaddr_in6>);

    case sio::getpeername:

      if (socket.peername.ss_family != AF_INET6)
        return not_connected;

      if (var result = vm::memcpy(iovec, 0, &socket.peername, sizeof<sockaddr_in6>); !result)
        return cast(result);

      return cast(sizeof<sockaddr_in6>);

    else:
      return not_supported;
  }
}

pub fn read(socket mut *socket, vm::iovec &iovec, usize offset, usize length, ancillary_data mut &ancillary_data) -> net::result
{
  var mut &tcb = *cast<tcb mut *>(socket.state);

  var guard = std::lock_guard(&mut tcb.lock);

  switch (tcb.state)
  {
    case closed:
    case listen:
      return not_connected;

    case syn_sent:
    case syn_received:
      return would_block;

    case close_wait:
      if (tcb.rcv_q.contiguous == 0)
        return cast(0);
  }

  var count = 0;
  var result = vm::result::ok;

  if (tcb.rcv_q.contiguous == 0)
    return would_block;

  var bytes = std::min(tcb.rcv_q.contiguous, length);

  tcb.rcv_q.foreach_packet_in(tcb.rcv_q.head, bytes, |packet, start, bytes| {
    if (!result)
      return;

    if (result = vm::memcpy(iovec, offset, packet.iovec, packet.start + start, bytes); !result)
      return;

    offset += bytes;
    count += bytes;
  });

  tcb.rcv_q.erase(tcb.rcv_q.head, tcb.rcv_q.head + count);

  tcb.rcv_wnd = tcb.rcv_q.size;

  if (tcb.state == tcp_state::established && tcb.rcv_q.contiguous == 0)
    io::initiate(&mut tcb.readable.cb, 1);

  return cast(count);
}

pub fn write(socket mut *socket, vm::iovec &iovec, usize offset, usize length, ancillary_data &ancillary_data) -> net::result
{
  var mut &tcb = *cast<tcb mut *>(socket.state);

  var guard = std::lock_guard(&mut tcb.lock);

  switch (tcb.state)
  {
    case closed:
      return not_connected;

    case listen:
      return address_required;

    case last_ack:
    case fin_wait_1:
    case fin_wait_2:
    case closing:
    case time_wait:
      return broken_pipe;
  }

  var count = std::min(tcb.snd_q.remaining, length);

  if (tcb.snd_q.remaining < TCP_SND_LOW_WATER_MARK)
    return would_block;

  var pkt = net::packet::with_capacity(0, count);

  if (var result = vm::memcpy(pkt.iovec, pkt.start + pkt.length, iovec, offset, count); !result)
    return cast(result);

  pkt.extend(count);

  tcb.snd_q.append(&mut pkt);

  if (tcb.snd_q.remaining < TCP_SND_LOW_WATER_MARK)
    io::initiate(&mut tcb.writeable.cb, 1);

  tcb.snd_nxt = tcb.snd_max;

  output(&mut tcb);

  return cast(count);
}

pub fn shutdown(socket mut *socket, u64 how) -> net::result
{
  var mut &tcb = *cast<tcb mut *>(socket.state);

  var guard = std::lock_guard(&mut tcb.lock);

  if (how == SHUT_WR || how == SHUT_RDWR)
  {
    switch (tcb.state)
    {
      case listen:
      case syn_sent:
        disconnect(&mut tcb, net::result::ok);

      case syn_received:
      case established:
        tcb.state = tcp_state::fin_wait_1;
        output(&mut tcb);

      case close_wait:
        tcb.state = tcp_state::last_ack;
        output(&mut tcb);
    }
  }

  return ok;
}

pub fn destroy(socket mut *socket) -> void
{
  var mut &tcb = *cast<tcb mut *>(socket.state);

  tcb.unref();
}
