//
// ip (raw) socket
//

import std.stdio;
import std.circular_buffer;
import vm;
import io;
import net.in;
import net.packet;
import net.result;
import net.protocols.ipv6 as ipv6;
import mutex as _ : mutex;
import socket as _ : socket, sockaddr, sockaddr_storage, ctrlhdr, ctrlattr, ancillary_data;
import support.rc : Rc;

using net::hwaddr;
using net::inaddr;
using net::in4addr;
using net::in6addr;

pub struct sockaddr_in4
{
  pub u16 sa_family;
  pub u16 sin4_port;
  pub in4addr sin4_addr;
  pub u8[8] sin4_zero;
}

pub struct sockaddr_in6
{
  pub u16 sa_family;
  pub u16 sin6_port;
  pub u32 sin6_flowinfo;
  pub in6addr sin6_addr;
  pub u32 sin6_scope_id;
}

enum cta
{
  const pktsrc = (41, 1);
  const pktdst = (41, 2);
  const timestamp = (41, 3);
  const ipv6_hoplimit = (41, 52);
  const ipv6_pathmtu = (41, 62);
}

enum sio
{
  const getsockname = 0x8003001b;
  const getpeername = 0x8003001c;
}

struct rawpkt
{
  net::rx rx;

  vm::iovec iovec;

  rawpkt() = default;
  rawpkt(rawpkt &&) = default;
  fn =(rawpkt mut &, rawpkt &&) -> rawpkt mut & = default;
  ~rawpkt() = default;
}

struct state
{
  mutex lock;

  std::circular_buffer<rawpkt, N:128> buffer;

  state() = default;
  ~state() = default;
}

pub fn pickup(socket mut *socket, rawpkt mut &rawpkt) -> net::result
{
  var mut &state = *cast<state mut *>(socket.state);

  var guard = std::lock_guard(&mut state.lock);

  if (state.buffer.len == 0)
    return would_block;

  rawpkt = state.buffer.take_front();

  if (state.buffer.len == 0)
    io::initiate(&mut socket.readable.cb, 1);

  return cast(1);
}

pub fn deliver(socket mut *socket, net::netdev mut *link, net::rx &rx, net::packet &pkt) -> net::result
{
  var mut &state = *cast<state mut *>(socket.state);

  var rawpkt = rawpkt();

  rawpkt.rx = rx;

  pkt.foreach_region(|region| {
    rawpkt.iovec.append(vm::lock(region));
  });

  var guard = std::lock_guard(&mut state.lock);

  state.buffer.push_back(&move rawpkt);

  if (state.buffer.len == 1)
    io::complete(&mut socket.readable.cb, 0);

  return cast(1);
}

pub fn open(socket mut *socket) -> net::result
{
  socket.state = std::allocator::new<state>();

  net::stack.ip.add_socket(socket);

  return ok;
}

pub fn bind(socket mut *socket, sockaddr *addr, usize alen) -> net::result
{
  var addr = cast<sockaddr_in6*>(addr);

  if (addr.sa_family != AF_INET6)
    return invalid_argument;

  if (alen != sizeof<sockaddr_in6>)
    return invalid_argument;

  var valid = false;

  if (addr.sin6_addr.is_unspecified)
    valid = true;

  net::enumerate(|id, link| {
    link.ipv6.enumerate_addrs(|ifa| {
      if (ifa.addr == addr.sin6_addr)
        valid = true;
    });
  });

  if (!valid)
    return address_not_available;

  std::memcpy(&socket.sockname, addr, alen);

  return ok;
}

pub fn connect(socket mut *socket, sockaddr *addr, usize alen) -> net::result
{
  var dst_ip = inaddr();

  switch (addr.sa_family)
  {
    case AF_INET6:
      if (alen != sizeof<sockaddr_in6>)
        return invalid_argument;

      dst_ip = cast<sockaddr_in6 *>(addr).sin6_addr;
  }

  if (dst_ip.is_unspecified)
    return address_required;

  var src_ip = inaddr();

  switch (socket.sockname.ss_family)
  {
    case AF_INET6:
      src_ip = cast<sockaddr_in6 &>(socket.sockname).sin6_addr;
  }

  var route = net::routes.find(dst_ip);

  if (!route)
    return host_unreachable;

  net::resolve_route(route, dst_ip, &mut socket.writeable.cb, &mut src_ip, &mut net::hwaddr());

  socket.sockname.ss_family = AF_INET6;
  cast<sockaddr_in6 mut &>(socket.sockname).sin6_addr = src_ip.in6;

  std::memcpy(&socket.peername, addr, alen);

  socket.writeable = io::response();

  return ok;
}

pub fn ioctl(socket mut *socket, u32 op, vm::iovec &iovec) -> net::result
{
  switch (op)
  {
    case sio::getsockname:

      if (var result = vm::memcpy(iovec, 0, &socket.sockname, sizeof<sockaddr_in6>); !result)
        return cast(result);

      return cast(sizeof<sockaddr_in6>);

    case sio::getpeername:

      if (socket.peername.ss_family != AF_INET6)
        return not_connected;

      if (var result = vm::memcpy(iovec, 0, &socket.peername, sizeof<sockaddr_in6>); !result)
        return cast(result);

      return cast(sizeof<sockaddr_in6>);

    else:
      return not_supported;
  }
}

pub fn read(socket mut *socket, vm::iovec &iovec, usize offset, usize length, ancillary_data mut &ancillary_data) -> net::result
{
  var pkt = rawpkt();

  if (var result = pickup(socket, &mut pkt); !result)
    return result;

  var count = 0;

  for (var host : pkt.iovec.host)
  {
    if (var result = vm::memcpy(iovec, offset, host.addr.ptr, host.size); !result)
      break;

    count += host.size;
    offset += host.size;
  }

  var pktsrc = sockaddr_storage();
  var pktsrc = cast<sockaddr_in6 mut *>(&pktsrc);

  pktsrc.sa_family = AF_INET6;
  pktsrc.sin6_addr = pkt.rx.src_ip.in6;

  ancillary_data.push_back(cta::pktsrc, pktsrc, sizeof(*pktsrc));

  ancillary_data.push_back(cta::timestamp, &pkt.rx.timestamp, sizeof(pkt.rx.timestamp));

  return cast(count);
}

pub fn write(socket mut *socket, vm::iovec &iovec, usize offset, usize length, ancillary_data &ancillary_data) -> net::result
{
  var dst_ip = inaddr();

  switch (socket.peername.ss_family)
  {
    case AF_INET6:
      dst_ip = cast<sockaddr_in6 &>(socket.peername).sin6_addr;
  }

  switch (ancillary_data[cta::pktdst])
  {
    case Some[cta]:
      if (socket.peername.ss_family != 0)
        return invalid_argument;

      if (cta.cta_len < sizeof<ctrlattr> + sizeof<sockaddr>)
        return invalid_argument;

      switch (cast<sockaddr *>(cta.cta_value.data).sa_family)
      {
        case AF_INET6:
          if (cta.cta_len < sizeof<ctrlattr> + sizeof<sockaddr_in6>)
            return invalid_argument;

          dst_ip = cast<sockaddr_in6 *>(cta.cta_value.data).sin6_addr;
      }
  }

  if (dst_ip.is_unspecified)
    return address_required;

  var src_ip = inaddr();

  switch (socket.sockname.ss_family)
  {
    case AF_INET6:
      src_ip = cast<sockaddr_in6 &>(socket.sockname).sin6_addr;
  }

  var route = net::routes.find(dst_ip);

  if (!route)
    return host_unreachable;

  var dst = net::hwaddr();

  if (var result = net::resolve_route(route, dst_ip, &mut socket.writeable.cb, &mut src_ip, &mut dst); !result)
    return result;

  var pkt = net::packet::with_capacity(256, length);

  if (var result = vm::memcpy(pkt.iovec, pkt.start + pkt.length, iovec, offset, length); !result)
    return cast(result);

  pkt.extend(length);

  var response = io::response();

  io::initiate(&mut response.cb, 1);

  ipv6::send(route.link, &mut response.cb, cast(socket.protocol), dst_ip.in6, src_ip.in6, dst, route.link.hwaddr, &mut pkt);

  return cast(length);
}

pub fn shutdown(socket mut *socket, u64 how) -> net::result
{
  var mut &state = *cast<state mut *>(socket.state);

  if (how == SHUT_RD || how == SHUT_RDWR)
    net::stack.ip.remove_socket(socket);

  return ok;
}

pub fn destroy(socket mut *socket) -> void
{
  var mut &state = *cast<state mut *>(socket.state);

  std::allocator::delete(cast<state mut *>(socket.state));
}
