//
// net qdisc
//

import std.stdlib;
import std.vector;
import net.result;
import io;
import vm;
import slab : slab_allocator;
import mutex as _ : mutex;
import support.rc : Rc;

struct txpkt
{
  enum status
  {
    pending,
    running,
  }

  status status;

  net::packet pkt;

  Rc<io::iocb> cb;

  txpkt mut *next;

  u8[40] reserved;

  fn allocator()
  {
    static allocator = #slab_allocator<txpkt>();

    return &allocator;
  }

  fn create() -> txpkt mut *
  {
    return allocator.allocate();
  }

  txpkt() = default;
  ~txpkt() = default;
}

fn destroy(txpkt mut *tx) -> void
{
  tx.cb = null;
  tx.pkt = net::packet();

  txpkt::allocator.free(tx);
}

pub struct qdisc
{
  mutex lock;

  usize len;

  txpkt mut *head;
  txpkt mut * mut *last;

  pub net::output_t dpc;

  pub fn len(this &) -> usize
  {
    return this.len;
  }

  fn append(this mut &, txpkt mut *tx) -> void
  {
    var guard = std::lock_guard(&mut this.lock);

    *this.last = tx;
    this.last = &tx.next;

    this.len += 1;
  }

  fn prepend(this mut &, txpkt mut *tx) -> void
  {
    var guard = std::lock_guard(&mut this.lock);

    tx.next = this.head;
    this.head = tx;

    if (!tx.next)
      this.last = &tx.next;

    this.len += 1;
  }

  fn pop_pending(this mut &) -> txpkt mut *
  {
    var guard = std::lock_guard(&mut this.lock);

    for (var curr = &this.head; *curr; curr = &curr.next)
    {
      var tx = *curr;

      if (tx.status == txpkt::status::pending)
      {
        *curr = curr.next;

        if (!*curr)
          this.last = curr;

        this.len -= 1;

        tx.next = null;

        return tx;
      }
    }

    return null;
  }

  fn pop_ready(this mut &) -> txpkt mut *
  {
    var guard = std::lock_guard(&mut this.lock);

    for (var curr = &this.head; *curr; curr = &curr.next)
    {
      var tx = *curr;

      if (tx.status == txpkt::status::running)
      {
        if (tx.cb.outstanding <= 0)
        {
          *curr = curr.next;

          if (!*curr)
            this.last = curr;

          this.len -= 1;

          tx.next = null;

          return tx;
        }
      }
    }

    return null;
  }

  pub qdisc()
  {
    this.last = &this.head;
  }

  pub ~qdisc() = default;
}

pub fn enqueue(qdisc mut &qdisc, Rc<io::iocb> mut &cb, net::packet mut &pkt) -> net::result
{
  if (qdisc.len > 1024)
    return device_busy;

  var tx = txpkt::create();
  tx.status = txpkt::status::pending;
  tx.pkt = std::exchange(&mut pkt, net::packet());
  tx.cb = cb;

  qdisc.append(tx);

  return ok;
}

pub fn run(qdisc mut &qdisc, net::netdev mut *link) -> net::result
{
  var tx = qdisc.pop_pending();

  if (!tx)
    return cast(0);

  switch (link.transmit(0, &mut tx.cb, &mut tx.pkt))
  {
    case net::result::ok:
      tx.status = txpkt::status::running;

      qdisc.append(tx);

      return cast(1);

    case net::result::device_busy:

      qdisc.prepend(tx);

      return cast(0);

    else[rc]:
      io::complete(&mut tx.cb, rc);

      destroy(tx);

      return cast(0);
  }
}

pub fn dequeue(qdisc mut &qdisc, net::packet mut &pkt) -> net::result
{
  var tx = qdisc.pop_ready();

  if (!tx)
    return would_block;

  pkt = &move tx.pkt;

  destroy(tx);

  return ok;
}