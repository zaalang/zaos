//
// lo interface
//

import std.stdio;
import std.atomic;
import vm;
import io;
import dev;
import net;
import support.rc : Rc;

using net::inaddr;
using net::in6addr;

pub struct lo : pub net::netdev
{
  pub lo()
    : super(&impl this)
  {
    this.type = net::type::loop;
    this.flags |= net::flags::loopback;
    this.flags |= net::flags::lower_up;
  }

  pub fn name(this &) -> std::string
  {
    return "lo";
  }

  pub fn query(this &, net::query query, std::string mut &result) override -> net::result
  {
    switch (query)
    {
      case name:
        result = std::format("");

      case type:
        result = std::format("loopback");

      case address:
        result = std::format("{}", this.hwaddr);

      case device_path:
        result = std::format("net/lo");
    }

    return ok;
  }

  pub fn transmit(this mut &, u16 txqid, Rc<io::iocb> mut &cb, net::packet mut &packet) override -> net::result
  {
    net::receive(&this, &mut packet);

    io::complete(&mut cb, 0);

    return ok;
  }

  pub fn retrieve(this mut &, u16 rxqid, net::packet mut &packet) override -> net::result
  {
    return not_supported;
  }

  pub fn refill(this mut &, u16 rxqid) override -> net::result
  {
    return ok;
  }

  pub ~lo() = default;
}

pub fn initialise() -> net::result
{
  var dev = net::netdev::create<lo>();

  dev::register(dev::dev_t(), dev);

  return ok;
}