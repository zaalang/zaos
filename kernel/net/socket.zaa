//
// network socket
//

import std.stdio;
import vm;
import io;
import net.result;
import net.protocols.ip.socket as ip.socket;
import net.protocols.udp.socket as udp.socket;
import net.protocols.tcp.socket as tcp.socket;
import socket as _ : socket, sockaddr, sockaddr_storage, ctrlhdr, ctrlattr, ancillary_data;
import support.rc : Rc;

using net::inaddr;
using ip::sockaddr_in4;
using ip::sockaddr_in6;

pub fn open(socket mut *socket) -> net::result
{
  switch (socket.type)
  {
    case SOCK_RAW:
      return ip::open(socket);

    case SOCK_DGRAM:
      return udp::open(socket);

    case SOCK_STREAM:
      return tcp::open(socket);
  }

  return ok;
}

pub fn bind(socket mut *socket, sockaddr *addr, usize alen) -> net::result
{
  switch (socket.type)
  {
    case SOCK_RAW:
      return ip::bind(socket, addr, alen);

    case SOCK_DGRAM:
      return udp::bind(socket, addr, alen);

    case SOCK_STREAM:
      return tcp::bind(socket, addr, alen);

    else:
      return not_supported;
  }
}

pub fn connect(socket mut *socket, sockaddr *addr, usize alen) -> net::result
{
  switch (socket.type)
  {
    case SOCK_RAW:
      return ip::connect(socket, addr, alen);

    case SOCK_DGRAM:
      return udp::connect(socket, addr, alen);

    case SOCK_STREAM:
      return tcp::connect(socket, addr, alen);

    else:
      return not_supported;
  }
}

pub fn ioctl(socket mut *socket, u32 op, vm::iovec &iovec) -> net::result
{
  switch (socket.type)
  {
    case SOCK_RAW:
      return ip::ioctl(socket, op, iovec);

    case SOCK_DGRAM:
      return udp::ioctl(socket, op, iovec);

    case SOCK_STREAM:
      return tcp::ioctl(socket, op, iovec);

    else:
      return not_supported;
  }
}

pub fn read(socket mut *socket, vm::iovec &iovec, usize offset, usize length, ancillary_data mut &ancillary_data) -> net::result
{
  switch (socket.type)
  {
    case SOCK_RAW:
      return ip::read(socket, iovec, offset, length, &mut ancillary_data);

    case SOCK_DGRAM:
      return udp::read(socket, iovec, offset, length, &mut ancillary_data);

    case SOCK_STREAM:
      return tcp::read(socket, iovec, offset, length, &mut ancillary_data);

    else:
      return not_supported;
  }
}

pub fn write(socket mut *socket, vm::iovec &iovec, usize offset, usize length, ancillary_data &ancillary_data) -> net::result
{
  switch (socket.type)
  {
    case SOCK_RAW:
      return ip::write(socket, iovec, offset, length, ancillary_data);

    case SOCK_DGRAM:
      return udp::write(socket, iovec, offset, length, ancillary_data);

    case SOCK_STREAM:
      return tcp::write(socket, iovec, offset, length, ancillary_data);

    else:
      return not_supported;
  }
}

pub fn shutdown(socket mut *socket, u64 how) -> net::result
{
  switch (socket.type)
  {
    case SOCK_RAW:
      return ip::shutdown(socket, how);

    case SOCK_DGRAM:
      return udp::shutdown(socket, how);

    case SOCK_STREAM:
      return tcp::shutdown(socket, how);
  }

  return ok;
}

pub fn destroy(socket mut *socket) -> void
{
  switch (socket.type)
  {
    case SOCK_RAW:
      ip::destroy(socket);

    case SOCK_DGRAM:
      udp::destroy(socket);

    case SOCK_STREAM:
      tcp::destroy(socket);
  }
}
