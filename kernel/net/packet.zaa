//
// net packet
//

import std.atomic;
import std.vector;
import vm;
import io;
import net.result;
import support.rc : Rc;

pub struct packet
{
  pub enum type
  {
    eth,
    arp,
    ipv4,
    ipv6,
    udp,
    tcp,
  }

  pub type type;

  pub usize start;
  pub usize length;

  pub vm::iovec iovec;

  pub fn with_capacity(usize bck, usize fwd) -> packet
  {
    var pkt = packet();

    for (; pkt.iovec.length < bck + fwd; )
    {
      pkt.iovec.append(vm::lock(vm::allocate_physical_page()));
    }

    pkt.start = bck;

    return pkt;
  }

  pub packet() = default;
  pub packet(packet &&other) = default;
  pub fn =(packet mut &, packet &&) -> packet mut & = default;
  pub ~packet() = default;
}

pub fn as<T>(packet &pkt, usize size = sizeof<T>) -> T *
{
  if (pkt.length < size)
    return null;

  std::assert(pkt.start + size <= pkt.iovec.host[0].size);

  return cast<T*>((pkt.iovec.host[0].addr + pkt.start).ptr);
}

pub fn as<T>(packet mut &pkt, usize size = sizeof<T>) -> T mut *
{
  if (pkt.length < size)
    return null;

  std::assert(pkt.start + size <= pkt.iovec.host[0].size);

  return cast<T mut *>((pkt.iovec.host[0].addr + pkt.start).ptr);
}

pub fn foreach_region(packet &pkt, var &&callback) -> void
{
  var start = pkt.start;
  var remaining = pkt.length;

  for (var i = pkt.iovec.host.begin; i != pkt.iovec.host.end && remaining != 0; ++i)
  {
    var data = (*i).addr + start;
    var bytes = std::min((*i).size - start, remaining);

    callback(vm::physrange(data, bytes));

    remaining -= bytes;
    start = 0;
  }
}

pub fn inset(packet mut &pkt, vm::iovec &iovec, usize offset, usize length) -> void
{
  pkt.start += length;

  iovec.foreach_region_in(offset, length, |region| {
    pkt.iovec.append(vm::lock(region));
  });
}

pub fn prepend<T>(packet mut &pkt, usize size = sizeof<T>) -> T mut *
{
  pkt.start -= size;
  pkt.length += size;

  return cast<T mut *>((pkt.iovec.host[0].addr + pkt.start).ptr);
}

pub fn append(packet mut &pkt, vm::iovec &iovec, usize offset, usize length) -> void
{
  pkt.length += length;

  iovec.foreach_region_in(offset, length, |region| {
    pkt.iovec.append(vm::lock(region));
  });
}

pub fn strip(packet mut &pkt, usize size) -> void
{
  std::assert(size <= pkt.length);

  pkt.start += size;
  pkt.length -= size;
}

pub fn extend(packet mut &pkt, usize size) -> void
{
  std::assert(size <= pkt.iovec.length - pkt.start);

  pkt.length += size;
}

pub fn trim(packet mut &pkt, usize size) -> void
{
  std::assert(size <= pkt.length);

  pkt.length = size;
}

pub struct packet_allocator
{
  pub fn allocate(this mut &, usize bck) -> packet
  {
    var pkt = packet();

    if (this.used + bck > this.page.size)
    {
      vm::unlock(this.page);

      this.page = vm::lock(vm::allocate_physical_page());
      this.used = 0;
    }

    std::assert(this.used + bck <= this.page.size);

    pkt.iovec.append(vm::lock(vm::physrange(this.page.addr + this.used, bck)));

    this.used += bck;

    pkt.start = bck;

    return pkt;
  }

  pub fn allocate(this mut &, usize bck, usize fwd) -> packet
  {
    var pkt = packet();

    if (bck + fwd < 2048)
    {
      pkt = allocate(&mut this, bck + fwd);
    }

    for (; pkt.iovec.length < bck + fwd; )
    {
      pkt.iovec.append(vm::lock(vm::allocate_physical_page()));
    }

    pkt.start = bck;

    return pkt;
  }

  pub fn free(this mut &) -> void
  {
    vm::unlock(this.page);
  }

  usize used;
  vm::physrange page;

  pub packet_allocator() = default;
  pub packet_allocator(#packet_allocator &) = default;
  pub ~packet_allocator() = default;
}
