import std.stdio;
import std.env;
import sys.thread;
import net.ip;
import os.zaos.fcntl;
import os.zaos.socket;
import os.zaos.time;
import std.byteconv;
import aargh;

using os;

struct opts
{
  #[arg(value, short='w', help="wait timeout")]
  u64 waittime = 10;

  opts() = default;
  ~opts() = default;
}

extern fn thread_ring() -> os::ioring mut &;

fn socket(i32 family, i32 type, i32 protocol) -> i32
{
  return os::socket(&mut thread_ring, family, type, protocol);
}

fn bind(i32 fd, os::sockaddr *addr, usize alen, opts &opts) -> i32
{
  return os::socket_bind(&mut thread_ring, fd, addr, alen);
}

fn connect(i32 fd, os::sockaddr *addr, usize alen, opts &opts) -> i32
{
  var rc = os::socket_connect(&mut thread_ring, fd, addr, alen);

  while (rc == EAGAIN)
  {
    var tp = os::timespec(void);
    os::clock_gettime(os::clock::monotonic, &tp);

    var pollset = [ os::pollevt(fd, POLLFD, POLLOUT, 0) ];

    os::sleep(&mut thread_ring, tp + 1_000_000);
    os::select(&mut thread_ring, pollset.data, pollset.len, tp + 1_000_000_000);

    rc = os::socket_connect(&mut thread_ring, fd, addr, alen);
  }

  if (rc == EINPROGRESS)
  {
    var tp = os::timespec(void);
    os::clock_gettime(os::clock::monotonic, &tp);

    var pollset = [ os::pollevt(fd, POLLFD, POLLOUT | POLLPRI, 0) ];

    if (os::select(&mut thread_ring, pollset.data, pollset.len, tp + opts.waittime * 1_000_000_000) <= 0)
      return ETIMEDOUT;

    os::ioctl(&mut thread_ring, fd, SIO_SOERROR, &rc, sizeof(rc));
  }

  return rc;
}

fn main() -> i32
{
  var opts = aargh::parse<opts>(std::env::args);

  var sockname = os::sockaddr_in6();
  sockname.sa_family = AF_INET6;
  sockname.sin6_addr = os::in6addr_any();
  sockname.sin6_port = 0;

  var peername = os::sockaddr_in6();
  peername.sa_family = AF_INET6;
  peername.sin6_addr = os::in6_addr([ 0xfe, 0x80, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x02 ]);
  peername.sin6_port = std::native_to_be(2000);

  var fd = socket(AF_INET6, SOCK_STREAM, 0);

  if (fd < 0)
    std::panic("socket - ", cast<std::errc>(-fd));

  if (var rc = bind(fd, &sockname, sizeof(sockname), opts); rc < 0)
    std::panic("bind - ", cast<std::errc>(-rc));

  if (var rc = connect(fd, &peername, sizeof(peername), opts); rc < 0)
    std::panic("connect - ", cast<std::errc>(-rc));

  std::print("connected...");

  for (;;)
  {
    var pollset = [ os::pollevt(fd, POLLFD, POLLOUT, 0) ];

    if (var rc = os::select(&mut thread_ring, pollset.data, pollset.len, ~0); rc <= 0)
      std::panic("writeable - ", cast<std::errc>(-rc));

    var buffer = "Hello...";
    var nout = os::write(&mut thread_ring, fd, buffer.data, buffer.len);

    if (nout < 0)
      break;

    break;
  }

  for (var ii = usize(1); ii <= 1024*1024; ++ii)
  {
    var pollset = [ os::pollevt(fd, POLLFD, POLLOUT, 0) ];

    if (var rc = os::select(&mut thread_ring, pollset.data, pollset.len, ~0); rc <= 0)
      std::panic("writeable - ", cast<std::errc>(-rc));

    var nout = os::write(&mut thread_ring, fd, &ii, sizeof(ii));

    std::print(ii, " ", nout);

    if (nout != 8)
      std::panic("write - ", nout);
  }

  var cnt = 0;
  var checksum = u32(0);

  var testsum = usize(0);
  var countsum = usize(0);

  for (;;)
  {
    var pollset = [ os::pollevt(fd, POLLFD, POLLIN, 0) ];

    if (var rc = os::select(&mut thread_ring, pollset.data, pollset.len, ~0); rc <= 0)
      std::panic("readable - ", cast<std::errc>(-rc));

    var buffer = [u8(0); 512];
    var bytes = os::read(&mut thread_ring, fd, buffer.data, buffer.len);

    if (bytes <= 0)
      break;

    //std::puts(std::string_view(buffer.data, cast<usize>(bytes)));

    for (var i = 0; i + 1 < cast<usize>(bytes); i += 2)
      checksum = std::add_with_carry(checksum, cast<u32>(*(buffer.data + i)) << 8 | cast<u32>(*(buffer.data + i + 1))).0;

    if (bytes & 1 != 0)
      checksum += cast<u32>(*(buffer.data + cast<usize>(bytes) - 1)) << 8;

    for (var i = 0; i < cast<usize>(bytes); ++i)
      countsum += cast(buffer[i]);

    for (var i = 0; i < cast<usize>(bytes); ++i)
    {
      var packed = usize((cnt + i) / 8);

      testsum += cast(cast<u8[8]*>(&packed)[(cnt + i) % 8]);

      if (buffer[i] != cast(cast<u8[8]*>(&packed)[(cnt + i) % 8]))
        std::panic("mismatch");
    }

    cnt += cast<usize>(bytes);

    std::print(cnt, " ", bytes, " ", checksum, " ", countsum, " ", testsum);

    if (countsum != testsum)
      break;
  }

  std::print("closing...");

  os::close(&mut thread_ring, fd);

  return 0;
}
